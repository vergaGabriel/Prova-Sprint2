# ===== MQTT =====
# Broker MQTT. Pra rodar local com Mosquitto: mqtt://localhost:1883
# Pra rodar contra HiveMQ publico: mqtt://broker.hivemq.com:1883
MQTT_URL=mqtt://localhost:1883

# Namespace opcional pra topicos. Deixe vazio pra usar topicos EXATOS do spec
# (campus/parking/...). Util quando rodar no broker publico pra evitar colisao
# com outros alunos: TOPIC_NAMESPACE=meu-grupo-x
TOPIC_NAMESPACE=

# ===== Postgres =====
# String de conexao do banco (Etapa 3).
# Padrao bate com o docker-compose.yml deste repositorio.
DATABASE_URL=postgres://parking:parking@localhost:5432/parking

# ===== Simulador =====
# Velocidade do tick (ms). Menor = simulacao mais rapida.
TICK_MS=1000

# Intervalo de heartbeat dos gateways (segundos).
GATEWAY_STATUS_INTERVAL_S=15

# ===== Backend =====
# Portas HTTP.
SIM_CONTROL_PORT=4000
API_PORT=4001

# Intervalo de snapshot por setor (ms). Spec sugere 60000 (1 min).
SNAPSHOT_INTERVAL_MS=60000
